[Unit]
Description=Sentry GDL90 traffic bridge
Wants=network-online.target
After=network-online.target

[Service]
EnvironmentFile=-/etc/default/sentry-bridge
ExecStart=/opt/sentry-bridge/venv/bin/python -u /opt/sentry-bridge/bridge.py $BRIDGE_ARGS
Restart=always
RestartSec=2
DynamicUser=yes
StateDirectory=sentry-bridge
WorkingDirectory=/var/lib/sentry-bridge
# --log-raw recordings contain this aircraft's position: owner-only files.
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
