[Unit]
Description=Sentry Bridge WiFi address
Wants=avahi-daemon.service
After=avahi-daemon.service network.target

[Service]
ExecStart=/usr/bin/python3 /opt/sentry-bridge/deploy/publish-mdns.py
Restart=on-failure
RestartSec=5
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
