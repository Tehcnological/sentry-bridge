[Unit]
Description=Sentry Bridge web controller
Wants=network-online.target avahi-daemon.service
After=network-online.target
Conflicts=sentry-bridge.service

[Service]
User=sentry-bridge
Group=sentry-bridge
WorkingDirectory=/opt/sentry-bridge
ExecStart=/opt/sentry-bridge/venv/bin/python /opt/sentry-bridge/tools/pi_server.py --port 80
Restart=on-failure
RestartSec=3
StateDirectory=sentry-bridge
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
